<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- HEADER -->
    <RelativeLayout
        android:id="@+id/headerCategorias"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:src="@drawable/outline_arrow_circle_left_24"
            app:tint="#999999" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Categorias"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnHerramienta"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/herramienta" />
    </RelativeLayout>

    <!-- BOTONES FILTRO -->
    <LinearLayout
        android:id="@+id/layoutFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerCategorias"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/btnBreakfast"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Breakfast"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textColor="#666666" />

        <Button
            android:id="@+id/btnLunch"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Lunch"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textColor="#666666" />

        <Button
            android:id="@+id/btnDinner"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Dinner"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textColor="#666666" />
    </LinearLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutFiltros"
        android:layout_above="@id/navBarInferior">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="true"
            android:alignmentMode="alignMargins"
            android:padding="8dp">

            <include
                android:id="@+id/plato1"
                layout="@layout/item_producto_categoria"
                android:layout_width="0dp"
                android:layout_columnWeight="1" />

            <include
                android:id="@+id/plato2"
                layout="@layout/item_producto_categoria"
                android:layout_width="0dp"
                android:layout_columnWeight="1" />

            <include
                android:id="@+id/plato3"
                layout="@layout/item_producto_categoria"
                android:layout_width="0dp"
                android:layout_columnWeight="1" />

            <include
                android:id="@+id/plato4"
                layout="@layout/item_producto_categoria"
                android:layout_width="0dp"
                android:layout_columnWeight="1" />

            <include
                android:id="@+id/plato5"
                layout="@layout/item_producto_categoria"
                android:layout_width="0dp"
                android:layout_columnWeight="1" />

            <include
                android:id="@+id/plato6"
                layout="@layout/item_producto_categoria"
                android:layout_width="0dp"
                android:layout_columnWeight="1" />

        </GridLayout>
    </ScrollView>

    <!-- NAV -->
    <LinearLayout
        android:id="@+id/navBarInferior"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:src="@drawable/outline_home_24"
            app:tint="#8BC34A" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:src="@drawable/baseline_search_24"
            app:tint="#666666" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_centerInParent="true"
                android:src="@drawable/bg_circle_green" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerInParent="true"
                android:src="@drawable/outline_add_shopping_cart_24"
                app:tint="#FFFFFF" />
        </RelativeLayout>

        <ImageView
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:src="@drawable/outline_attach_money_24" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:src="@drawable/outline_account_circle_24" />

    </LinearLayout>

</RelativeLayout>